<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<testCase guid="aefe23e4-8145-4d77-a849-e4139af9d396">
  <summary/>
  <steps>
    <apiCall apiId="com.provar.plugins.forcedotcom.core.ui.UiConnect" guid="58e47d6f-4606-41e3-a203-0cad4437bce9" name="UiConnect" testItemId="1" title="UI Connect: CqfWeb">
      <arguments>
        <argument id="connectionName">
          <value class="value" valueClass="string">CqfWeb</value>
        </argument>
