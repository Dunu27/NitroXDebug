        <argument id="captureAfter">
          <value class="value" valueClass="string">false</value>
        </argument>
      </arguments>
      <clauses>
        <clause name="substeps" testItemId="12">
          <steps>
            <apiCall apiId="com.provar.plugins.forcedotcom.core.ui.UiAssert" guid="74f436e2-b81d-4974-8957-18e33239b7b8" name="UiAssert" testItemId="13" title="UI Assert">
              <arguments>
                <argument id="resultName">
                  <value class="value" valueClass="string">Values</value>
                </argument>
                <argument id="resultScope">
                  <value class="value" valueClass="string">Test</value>
                </argument>
                <argument id="fieldAssertions">
                  <value class="valueList" mutable="Mutable">
                    <uiFieldAssertion resultName="cannotTypeHere">
                      <fieldLocator uri="ui:pageobject:field?field=frame%2Fframe%2FcannotTypeHere&amp;pageId=pageobjects.CqfWeb"/>
                      <attributeAssertions>
                        <uiAttributeAssertion attributeName="disabled" comparisonType="EqualTo">
                          <value class="value" valueClass="boolean">true</value>
                        </uiAttributeAssertion>
                        <uiAttributeAssertion attributeName="visible" comparisonType="EqualTo">
                          <value class="value" valueClass="boolean">true</value>
                        </uiAttributeAssertion>
                        <uiAttributeAssertion attributeName="inView" comparisonType="EqualTo">
                          <value class="value" valueClass="string">Fully</value>
                        </uiAttributeAssertion>
                        <uiAttributeAssertion attributeName="inlineEditable" comparisonType="EqualTo">
                          <value class="value" valueClass="boolean">false</value>
                        </uiAttributeAssertion>
                        <uiAttributeAssertion attributeName="readOnly" comparisonType="EqualTo">
                          <value class="value" valueClass="boolean">true</value>
                        </uiAttributeAssertion>
                      </attributeAssertions>
                    </uiFieldAssertion>
                  </value>
                </argument>
                <argument id="captureAfter">
                  <value class="value" valueClass="string">false</value>
