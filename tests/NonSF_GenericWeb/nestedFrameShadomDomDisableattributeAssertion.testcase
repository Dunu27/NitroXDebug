                <argument id="fieldAssertions">
                  <value class="valueList" mutable="Mutable">
                    <uiFieldAssertion resultName="disabledButton">
                      <fieldLocator uri="ui:pageobject:field?field=frame%2Fframe%2FdisabledButton&amp;pageId=pageobjects.CqfWeb"/>
                      <attributeAssertions>
                        <uiAttributeAssertion attributeName="disabled" comparisonType="EqualTo">
