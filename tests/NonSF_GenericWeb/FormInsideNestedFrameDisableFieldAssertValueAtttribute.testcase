<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<testCase guid="d8742acf-b55a-4957-987c-432ecbdf99c4">
  <summary/>
  <steps>
    <apiCall apiId="com.provar.plugins.forcedotcom.core.ui.UiConnect" guid="f3f39c6b-dc6a-4795-b141-5e0fd2dd608c" name="UiConnect" testItemId="1" title="UI Connect: CqfWeb">
      <arguments>
        <argument id="connectionName">
          <value class="value" valueClass="string">CqfWeb</value>
        </argument>
        <argument id="connectionId">
          <value class="value" valueClass="id">a73f335e-6a47-419b-bf2a-e83ed298ad5a</value>
        </argument>
        <argument id="resultName">
          <value class="value" valueClass="string">CqfWeb</value>
        </argument>
        <argument id="resultScope">
          <value class="value" valueClass="string">Test</value>
        </argument>
        <argument id="reuseConnectionName"/>
        <argument id="privateBrowsingMode"/>
        <argument id="webBrowser"/>
      </arguments>
    </apiCall>
    <apiCall apiId="com.provar.plugins.forcedotcom.core.ui.UiWithScreen" guid="42a47506-0cf0-4c90-a3e3-f968b2aa9baf" name="UiWithScreen" testItemId="2" title="On CqfWebPage page">
      <arguments>
        <argument id="uiConnectionName">
          <value class="value" valueClass="string">CqfWeb</value>
        </argument>
        <argument id="target">
          <value class="uiTarget" uri="ui:pageobject:target?pageId=pageobjects.CqfWebPage"/>
        </argument>
        <argument id="navigate">
          <value class="value" valueClass="string">Always</value>
        </argument>
        <argument id="targetDescription">
          <value class="value" valueClass="string">On CqfWebPage page</value>
        </argument>
        <argument id="windowSelection">
          <value class="value" valueClass="string">Default</value>
        </argument>
        <argument id="windowSize">
          <value class="value" valueClass="string">Default</value>
        </argument>
        <argument id="closeWindow"/>
        <argument id="captureBefore">
          <value class="value" valueClass="string">false</value>
        </argument>
        <argument id="captureAfter">
          <value class="value" valueClass="string">false</value>
        </argument>
      </arguments>
      <clauses>
        <clause name="substeps" testItemId="3">
          <steps>
            <apiCall apiId="com.provar.plugins.forcedotcom.core.ui.UiAssert" guid="77faf44a-5bb1-492c-9d31-c3029e2ec867" name="UiAssert" testItemId="4" title="UI Assert">
              <arguments>
                <argument id="resultName">
                  <value class="value" valueClass="string">Values</value>
                </argument>
                <argument id="resultScope">
                  <value class="value" valueClass="string">Test</value>
                </argument>
                <argument id="fieldAssertions">
                  <value class="valueList" mutable="Mutable">
                    <uiFieldAssertion resultName="NestedInsideFrameDisabledField">
                      <fieldLocator uri="ui:pageobject:field?field=frame%2Fframe%2FNestedInsideFrameDisabledField&amp;pageId=pageobjects.CqfWebPage"/>
                      <attributeAssertions>
                        <uiAttributeAssertion attributeName="disabled" comparisonType="EqualTo">
                          <value class="value" valueClass="boolean">true</value>
                        </uiAttributeAssertion>
                        <uiAttributeAssertion attributeName="visible" comparisonType="EqualTo">
                          <value class="value" valueClass="boolean">true</value>
                        </uiAttributeAssertion>
                        <uiAttributeAssertion attributeName="focused" comparisonType="EqualTo">
                          <value class="value" valueClass="boolean">false</value>
                        </uiAttributeAssertion>
                        <uiAttributeAssertion attributeName="inView" comparisonType="EqualTo">
                          <value class="value" valueClass="string">Fully</value>
                        </uiAttributeAssertion>
                        <uiAttributeAssertion attributeName="inlineEditable" comparisonType="EqualTo">
                          <value class="value" valueClass="boolean">false</value>
                        </uiAttributeAssertion>
                        <uiAttributeAssertion attributeName="readOnly" comparisonType="EqualTo">
                          <value class="value" valueClass="boolean">true</value>
                        </uiAttributeAssertion>
                        <uiAttributeAssertion attributeName="value" comparisonType="EqualTo" normalize="true"/>
                      </attributeAssertions>
                    </uiFieldAssertion>
                  </value>
                </argument>
                <argument id="captureAfter">
                  <value class="value" valueClass="string">false</value>
                </argument>
                <argument id="columnAssertions">
                  <value class="valueList" mutable="Mutable"/>
                </argument>
                <argument id="pageAssertions">
                  <value class="valueList" mutable="Mutable"/>
                </argument>
                <argument id="locatorParams"/>
                <argument id="beforeWait">
                  <value class="uiWait" uri="default"/>
                </argument>
                <argument id="autoRetry">
                  <value class="uiWait" uri="ui:wait:autoRetry:timeout=10"/>
                </argument>
                <argument id="captureBefore">
                  <value class="value" valueClass="string">false</value>
                </argument>
              </arguments>
            </apiCall>
            <apiCall apiId="com.provar.plugins.forcedotcom.core.ui.UiAssert" guid="523061e5-b85a-493f-b2fd-2be436401cdc" name="UiAssert" testItemId="5" title="UI Assert">
              <arguments>
                <argument id="resultName">
                  <value class="value" valueClass="string">Values</value>
                </argument>
                <argument id="resultScope">
                  <value class="value" valueClass="string">Test</value>
                </argument>
                <argument id="fieldAssertions">
                  <value class="valueList" mutable="Mutable">
                    <uiFieldAssertion resultName="disabledButton">
                      <fieldLocator uri="ui:pageobject:field?field=frame%2Fframe%2FdisabledButton&amp;pageId=pageobjects.CqfWebPage"/>
                      <attributeAssertions>
                        <uiAttributeAssertion attributeName="value" comparisonType="EqualTo" normalize="true">
                          <value class="value" valueClass="string">Disabled Button</value>
                        </uiAttributeAssertion>
                        <uiAttributeAssertion attributeName="disabled" comparisonType="EqualTo">
                          <value class="value" valueClass="boolean">true</value>
                        </uiAttributeAssertion>
                        <uiAttributeAssertion attributeName="visible" comparisonType="EqualTo">
                          <value class="value" valueClass="boolean">true</value>
                        </uiAttributeAssertion>
                        <uiAttributeAssertion attributeName="focused" comparisonType="EqualTo">
                          <value class="value" valueClass="boolean">false</value>
                        </uiAttributeAssertion>
                        <uiAttributeAssertion attributeName="inView" comparisonType="EqualTo">
                          <value class="value" valueClass="string">Fully</value>
                        </uiAttributeAssertion>
                      </attributeAssertions>
                    </uiFieldAssertion>
                  </value>
                </argument>
                <argument id="captureAfter">
                  <value class="value" valueClass="string">false</value>
                </argument>
                <argument id="columnAssertions">
                  <value class="valueList" mutable="Mutable"/>
                </argument>
                <argument id="pageAssertions">
                  <value class="valueList" mutable="Mutable"/>
                </argument>
                <argument id="locatorParams"/>
                <argument id="beforeWait">
                  <value class="uiWait" uri="default"/>
                </argument>
                <argument id="autoRetry">
                  <value class="uiWait" uri="ui:wait:autoRetry:timeout=10"/>
                </argument>
              </arguments>
            </apiCall>
          </steps>
        </clause>
      </clauses>
    </apiCall>
  </steps>
</testCase>
