<testCase guid="13315328-2c78-4668-b0e8-8a47ac8e3aca">
  <summary/>
  <steps>
    <apiCall apiId="com.provar.plugins.forcedotcom.core.ui.UiConnect" guid="84aa8328-e7b5-45d3-a196-09d84b157108" name="UiConnect" testItemId="1" title="UI Connect: CqfWeb">
