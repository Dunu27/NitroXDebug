<testCase guid="26eec326-4a4e-4127-a117-c9ec68f05c92">
  <summary/>
  <steps>
    <apiCall apiId="com.provar.plugins.forcedotcom.core.ui.UiConnect" guid="03ef9087-8747-44e2-8dce-782f48747383" name="UiConnect" testItemId="1" title="UI Connect: CqfWeb">
      <arguments>
        <argument id="connectionName">
          <value class="value" valueClass="string">CqfWeb</value>
        </argument>
