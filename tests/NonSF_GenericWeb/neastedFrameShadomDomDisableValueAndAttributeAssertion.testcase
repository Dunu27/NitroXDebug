                <argument id="fieldAssertions">
                  <value class="valueList" mutable="Mutable">
                    <uiFieldAssertion resultName="cannotTypeHere">
                      <fieldLocator uri="ui:pageobject:field?field=frame%2Fframe%2FcannotTypeHere&amp;pageId=pageobjects.CqfWeb"/>
                      <attributeAssertions>
                        <uiAttributeAssertion attributeName="value" comparisonType="EqualTo" normalize="true"/>
                        <uiAttributeAssertion attributeName="disabled" comparisonType="EqualTo">
                          <value class="value" valueClass="boolean">true</value>
                        </uiAttributeAssertion>
                        <uiAttributeAssertion attributeName="visible" comparisonType="EqualTo">
                          <value class="value" valueClass="boolean">true</value>
                        </uiAttributeAssertion>
                        <uiAttributeAssertion attributeName="inView" comparisonType="EqualTo">
                          <value class="value" valueClass="string">Fully</value>
